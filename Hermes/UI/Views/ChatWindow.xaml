                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <TextBox x:Name="txtMessageInput" Grid.Column="1" Style="{StaticResource ModernTextBox}" Foreground="#1F2937" Height="45"/>
                        <Button Click="btnSendMessage_Click" Grid.Column="2" Content="GỬI" Style="{StaticResource SendButton}" Margin="15,0,0,0" Padding="30,0" Height="45"/>
                    </Grid>
                </Border>

                <!-- ===== INFO PANEL (slide in từ phải) ===== -->
                <Border x:Name="pnlChatInfo" Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                        Background="White" BorderBrush="#E5E7EB" BorderThickness="1,0,0,0"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header panel -->
                        <Border Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16,14">
                            <Grid>
                                <TextBlock Text="Thông tin" FontSize="15" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
                                <Button x:Name="btnCloseChatInfo" Click="btnCloseChatInfo_Click"
                                        Content="✕" Background="Transparent" BorderThickness="0"
                                        FontSize="16" Foreground="#6B7280" Cursor="Hand"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Avatar + tên -->
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,24,0,20">
                            <Grid HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Ellipse Width="72" Height="72"
                                         Fill="{Binding ElementName=lstChats, Path=SelectedItem.AvatarColor}"/>
                                <TextBlock Text="{Binding ElementName=lstChats, Path=SelectedItem.Initials}"
                                           Foreground="White" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="26"/>
                            </Grid>
                            <TextBlock x:Name="txtInfoChatName"
                                       Text="{Binding ElementName=lstChats, Path=SelectedItem.ChatName}"
                                       FontSize="17" FontWeight="Bold" Foreground="#1F2937"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtInfoChatType"
                                       FontSize="12" Foreground="#9CA3AF"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Chi tiết -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,0,16,16">

                                <!-- Mã hóa E2EE badge -->
                                <Border Background="#F0FDF4" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔒" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="Mã hóa đầu cuối E2EE" FontSize="13" FontWeight="SemiBold" Foreground="#15803D"/>
                                            <TextBlock Text="Tin nhắn chỉ có bạn và người nhận đọc được" FontSize="11" Foreground="#4ADE80" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ID cuộc trò chuyện -->
                                <Border Background="#F9FAFB" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="ID cuộc trò chuyện" FontSize="11" Foreground="#9CA3AF" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="txtInfoChatId" FontSize="13" Foreground="#374151" FontFamily="Consolas"/>
                                    </StackPanel>
                                </Border>

                                <!-- Thành viên (chỉ hiện với nhóm) -->
                                <Border x:Name="pnlInfoMembers" Background="#F9FAFB" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Thành viên nhóm" FontSize="11" Foreground="#9CA3AF" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <ItemsControl x:Name="icInfoMembers">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Background="Transparent" Tag="{Binding}">
                                                        <StackPanel.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="ℹ️ Xem thông tin" Click="MemberInfo_Click" CommandParameter="{Binding}"/>
                                                                <MenuItem Header="🚫 Xóa khỏi nhóm" Click="MemberKick_Click" CommandParameter="{Binding}" Visibility="{Binding KickVisibility}"/>
                                                            </ContextMenu>
                                                        </StackPanel.ContextMenu>
                                                        <Border Width="28" Height="28" CornerRadius="14" Background="#3B82F6" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="11" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" Foreground="#374151" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Nút rời nhóm -->
                                <Button x:Name="btnLeaveGroup" Content="🚪  Rời khỏi nhóm" Click="btnLeaveGroup_Click"
                                        Background="#FFFBEB" Foreground="#D97706"
                                        BorderThickness="0" Padding="12,10"
                                        FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Margin="0,4,0,0" Visibility="Collapsed">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" CornerRadius="8"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#FEF3C7"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Nút hành động -->
                                <Button Content="🗑️  Xóa cuộc trò chuyện" Click="btnInfoDeleteChat_Click"
                                        Background="#FEF2F2" Foreground="#EF4444"
                                        BorderThickness="0" Padding="12,10"
                                        FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Margin="0,4,0,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" CornerRadius="8"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <Grid x:Name="CallPopup" Visibility="Collapsed" Background="#CC000000" Panel.ZIndex="100" Grid.ColumnSpan="2">
            <Border Background="White" Width="320" Height="160" CornerRadius="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="txtCallStatus" Text="Có cuộc gọi đến..." FontSize="18" FontWeight="Bold" Foreground="#1F2937" HorizontalAlignment="Center" Margin="0,0,0,25"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="btnAcceptCall" Content="✅ Nghe" Width="100" Height="40" Background="#10B981" Foreground="White" FontWeight="Bold" Click="btnAcceptCall_Click" Margin="0,0,20,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="btnRejectCall" Content="❌ Từ chối" Width="100" Height="40" Background="#EF4444" Foreground="White" FontWeight="Bold" Click="btnRejectCall_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>