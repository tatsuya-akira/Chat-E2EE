<Window x:Class="Hermes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập - Hermes" Height="660" Width="460"
        MinHeight="620" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Grid>
        <Border Background="White" CornerRadius="10" Margin="24" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Center">
                <TextBlock Text="🔒 Hermes" FontSize="24" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,30" Foreground="#1F2937"/>

                <TextBlock Text="Email" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,5"/>
                <TextBox x:Name="txtEmail" Height="35" Padding="5" Margin="0,0,0,15" 
                         VerticalContentAlignment="Center" FontSize="14"/>

                <TextBlock Text="Mật khẩu" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPassword" Height="35" Padding="5" Margin="0,0,0,25" 
                             VerticalContentAlignment="Center" FontSize="14"/>

                <TextBlock Text="Quên mật khẩu?" Foreground="#3B82F6" FontWeight="SemiBold" FontSize="12"
                    Cursor="Hand" HorizontalAlignment="Right" Margin="0,-15,0,20" 
                    MouseLeftButtonDown="TextBlock_ForgotPassword_Click"/>

                <Button x:Name="btnLogin" Content="ĐĂNG NHẬP" IsDefault="True" Height="40" Background="#3B82F6" 
                    Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="btnLogin_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Grid Margin="0,15,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Separator Grid.Column="0" VerticalAlignment="Center" Background="#E5E7EB"/>
                    <TextBlock Grid.Column="1" Text="hoặc" Margin="10,0" Foreground="#9CA3AF" FontSize="12"/>
                    <Separator Grid.Column="2" VerticalAlignment="Center" Background="#E5E7EB"/>
                </Grid>

                <Button x:Name="btnGoogleLogin" Height="40" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" 
                        Cursor="Hand" Click="btnGoogleLogin_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="G" FontWeight="Bold" Foreground="#4285F4" FontSize="16"/>
                            <TextBlock Text="o" FontWeight="Bold" Foreground="#EA4335" FontSize="16"/>
                            <TextBlock Text="o" FontWeight="Bold" Foreground="#FBBC05" FontSize="16"/>
                            <TextBlock Text="g" FontWeight="Bold" Foreground="#4285F4" FontSize="16"/>
                            <TextBlock Text="l" FontWeight="Bold" Foreground="#34A853" FontSize="16"/>
                            <TextBlock Text="e" FontWeight="Bold" Foreground="#EA4335" FontSize="16"/>
                        </StackPanel>
                        <TextBlock Text="Đăng nhập bằng Google" FontWeight="SemiBold" Foreground="#374151" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <TextBlock Text="Chưa có tài khoản? " Foreground="#6B7280"/>
                    <TextBlock Text="Đăng ký ngay" Foreground="#3B82F6" FontWeight="SemiBold" 
                        Cursor="Hand" TextDecorations="Underline" MouseLeftButtonDown="TextBlock_Register_Click"/>
                </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>