<Window x:Class="Hermes.CreateChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo nhóm trò chuyện" 
        Width="460"
        SizeToContent="Height"
        MinHeight="350"
        MaxHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#F9FAFB"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox" x:Key="InputStyle">
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Foreground"      Value="#1F2937"/>
            <Setter Property="CaretBrush"      Value="#1F2937"/>
            <Setter Property="BorderBrush"     Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background"      Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24">

            <!-- Tiêu đề -->
            <TextBlock Text="👥  Tạo nhóm trò chuyện mới"
                       FontSize="17" FontWeight="Bold"
                       Foreground="#1F2937"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- Tên nhóm -->
            <TextBlock Text="Tên nhóm *" FontWeight="SemiBold" Foreground="#374151"
                       FontSize="12" Margin="0,0,0,6"/>
            <TextBox x:Name="txtGroupName"
                     Style="{StaticResource InputStyle}"
                     Height="38"
                     Margin="0,0,0,16"/>

            <!-- Tìm kiếm thành viên -->
            <TextBlock FontWeight="SemiBold" Foreground="#374151"
                       FontSize="12" Margin="0,0,0,6">
                <Run Text="Thêm thành viên *"/>
                <Run Text="  (Gõ tên hoặc email để tìm kiếm)" Foreground="#9CA3AF" FontSize="11" FontWeight="Normal"/>
            </TextBlock>
            <TextBox x:Name="txtSearchMember"
                     Style="{StaticResource InputStyle}"
                     Height="38"
                     TextChanged="txtSearchMember_TextChanged"
                     ToolTip="Nhập từ khóa tìm kiếm người dùng"/>

            <!-- Danh sách gợi ý từ ô search -->
            <Border x:Name="bdSuggestions" BorderBrush="#E5E7EB" BorderThickness="1" Background="White" CornerRadius="4" MaxHeight="140" Margin="0,4,0,12" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="icSuggestions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="8,6" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="SuggestionItem_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{Binding AvatarColor}" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="#1F2937"/>
                                            <TextBlock Text="{Binding Identifier}" FontSize="11" Foreground="#6B7280"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="➕ Thêm" Foreground="#3B82F6" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Danh sách thành viên đã chọn (Chips) -->
            <TextBlock Text="Đã chọn:" FontSize="12" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,8,0,6"/>
            <Border BorderBrush="#E5E7EB" BorderThickness="1" Background="#F9FAFB" CornerRadius="6" MinHeight="60" MaxHeight="130" Padding="8" Margin="0,0,0,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="icSelectedMembers">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="14" Padding="8,4" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="#1E40AF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Content="✕" Tag="{Binding UserId}" Click="RemoveMember_Click" Background="Transparent" BorderThickness="0" Foreground="#3B82F6" FontWeight="Bold" FontSize="12" Margin="6,0,0,0" Cursor="Hand"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <TextBlock Text="Tối thiểu 2 người tham gia khác bạn"
                       FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,20"/>

            <!-- Nút Tạo -->
            <Button Content="✅  Tạo nhóm"
                    Height="42"
                    Background="#3B82F6"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="14"
                    Cursor="Hand"
                    Click="btnCreate_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>
    </ScrollViewer>
</Window>