<Window x:Class="Hermes.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cuộc gọi" Height="480" Width="360"
        WindowStartupLocation="CenterOwner"
        Background="#1F2937" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <!-- Avatar + name -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Ellipse Width="100" Height="100" Fill="#3B82F6" Margin="0,0,0,20"/>
            <TextBlock x:Name="txtCallee" Text="..." FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock x:Name="txtCallStatus" Text="Đang gọi..." FontSize="14" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Controls -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,20">
            <Button x:Name="btnMute" Click="btnMute_Click" Width="60" Height="60" Margin="15,0"
                    Background="#374151" BorderThickness="0" Cursor="Hand" ToolTip="Tắt mic">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="30" Background="{TemplateBinding Background}" Padding="5">
                            <TextBlock Text="🎤" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnEndCall" Click="btnEndCall_Click" Width="70" Height="70" Margin="15,0"
                    Background="#EF4444" BorderThickness="0" Cursor="Hand" ToolTip="Kết thúc cuộc gọi">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="35" Background="{TemplateBinding Background}" Padding="5">
                            <TextBlock Text="📵" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnSpeaker" Click="btnSpeaker_Click" Width="60" Height="60" Margin="15,0"
                    Background="#374151" BorderThickness="0" Cursor="Hand" ToolTip="Loa ngoài">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="30" Background="{TemplateBinding Background}" Padding="5">
                            <TextBlock Text="🔊" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
